[Unit]
Description=AI Girls Hono Backend
Documentation=https://github.com/yourusername/ai-girls
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ai-girls/backend

# Environment variables
Environment="NODE_ENV=production"
Environment="PORT=3000"
Environment="GEMINI_API_KEY=your_actual_gemini_api_key_here"
Environment="BACKEND_URL=https://your-domain.com"

# Start command
ExecStart=/usr/bin/node /opt/ai-girls/backend/dist/index.js

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ai-girls

# Security
NoNewPrivileges=true
PrivateTmp=true

# Resource limits
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
