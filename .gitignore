*.vrm.res

# Large scene files (use binary .scn instead of text .tscn for version control)
scenes/*.tscn
godot/scenes/*.tscn

# Godot web build - exclude large .pck file (exceeds GitHub 100MB limit)
# Keep HTML, JS, WASM but exclude the packed game data
godot-web-build/*.pck

# Godot-specific ignores
.import/
.godot/
export.cfg
export_presets.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/tool-specific ignores
.DS_Store
*~
